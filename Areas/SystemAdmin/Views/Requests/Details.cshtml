@model SmartStock.Models.TenantRequest
@{
    ViewData["Title"] = "Review Request";
}

@* Breadcrumb *@
<div style="display:flex;align-items:center;gap:6px;font-size:13px;color:#9a7a80;margin-bottom:20px;">
    <a asp-action="Index" style="color:#9a7a80;text-decoration:none;">Requests</a>
    <i class="bi bi-chevron-right" style="font-size:10px;"></i>
    <span style="color:#fecdd3;">@Model.ShopName</span>
</div>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px;flex-wrap:wrap;">
    <div>
        <h1 style="font-size:22px;font-weight:700;color:#1f2937;margin:0;">@Model.ShopName</h1>
        <p style="font-size:13px;color:#6b7280;margin:4px 0 0;">Submitted @Model.CreatedAt.ToString("dddd, MMMM d, yyyy 'at' HH:mm")</p>
    </div>
    @if (Model.Status == "Pending")
    {
        <span style="background:#fef3c7;color:#92400e;border:1px solid #fcd34d;border-radius:20px;padding:5px 14px;font-size:13px;font-weight:600;">
            <i class="bi bi-clock me-1"></i>Pending Review
        </span>
    }
    else if (Model.Status == "Approved")
    {
        <span style="background:#dcfce7;color:#166534;border:1px solid #86efac;border-radius:20px;padding:5px 14px;font-size:13px;font-weight:600;">
            <i class="bi bi-check-circle me-1"></i>Approved
        </span>
    }
    else
    {
        <span style="background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;border-radius:20px;padding:5px 14px;font-size:13px;font-weight:600;">
            <i class="bi bi-x-circle me-1"></i>Rejected
        </span>
    }
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:820px;">

    @* Request details card *@
    <div style="grid-column:1/-1;background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;">
        <div style="padding:14px 20px;border-bottom:1px solid #f3f4f6;font-weight:600;color:#374151;font-size:14px;">
            <i class="bi bi-person-lines-fill me-2" style="color:#f43f5e;"></i>Request Details
        </div>
        <div style="padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div>
                <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#9ca3af;margin-bottom:4px;">Business Name</div>
                <div style="font-size:14px;font-weight:600;color:#1f2937;">@Model.ShopName</div>
            </div>
            <div>
                <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#9ca3af;margin-bottom:4px;">Owner / Contact</div>
                <div style="font-size:14px;color:#374151;">@Model.OwnerName</div>
            </div>
            <div>
                <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#9ca3af;margin-bottom:4px;">Email</div>
                <div style="font-size:14px;color:#374151;">@Model.Email</div>
            </div>
            <div>
                <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#9ca3af;margin-bottom:4px;">Phone</div>
                <div style="font-size:14px;color:#374151;">@(Model.Phone ?? "—")</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.BusinessType))
            {
                <div>
                    <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#9ca3af;margin-bottom:4px;">Business Type</div>
                    <div style="font-size:14px;color:#374151;">@Model.BusinessType</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div style="grid-column:1/-1;">
                    <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#9ca3af;margin-bottom:4px;">Message</div>
                    <div style="font-size:13.5px;color:#374151;line-height:1.6;background:#f9fafb;border-radius:8px;padding:12px;">@Model.Message</div>
                </div>
            }
        </div>
    </div>

    @if (Model.Status == "Pending")
    {
        @* Approve card *@
        <div style="background:#fff;border:1px solid #86efac;border-radius:12px;overflow:hidden;">
            <div style="padding:14px 20px;border-bottom:1px solid #f3f4f6;font-weight:600;color:#166534;font-size:14px;background:#f0fdf4;">
                <i class="bi bi-check-circle-fill me-2"></i>Approve &amp; Create Tenant
            </div>
            <div style="padding:20px;">
                <p style="font-size:13px;color:#6b7280;margin-bottom:16px;">
                    This will create a new tenant and a TenantAdmin account for <strong>@Model.Email</strong>.
                </p>
                <form asp-action="Approve" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div style="margin-bottom:14px;">
                        <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">
                            Initial Password <span style="color:#dc2626;">*</span>
                        </label>
                        <input type="password" name="adminPassword" required minlength="6"
                               style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:13.5px;outline:none;"
                               placeholder="Min. 6 characters" />
                        <div style="font-size:11.5px;color:#6b7280;margin-top:4px;">Share this password securely with the owner.</div>
                    </div>
                    <div style="margin-bottom:16px;">
                        <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">Admin Notes (optional)</label>
                        <textarea name="adminNotes" rows="2"
                                  style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:13.5px;outline:none;resize:vertical;"
                                  placeholder="Internal notes..."></textarea>
                    </div>
                    <button type="submit" style="width:100%;background:#16a34a;color:#fff;border:none;border-radius:8px;padding:10px;font-size:13.5px;font-weight:600;cursor:pointer;">
                        <i class="bi bi-check-lg me-1"></i> Approve &amp; Create
                    </button>
                </form>
            </div>
        </div>

        @* Reject card *@
        <div style="background:#fff;border:1px solid #fca5a5;border-radius:12px;overflow:hidden;">
            <div style="padding:14px 20px;border-bottom:1px solid #f3f4f6;font-weight:600;color:#991b1b;font-size:14px;background:#fef2f2;">
                <i class="bi bi-x-circle-fill me-2"></i>Reject Request
            </div>
            <div style="padding:20px;">
                <p style="font-size:13px;color:#6b7280;margin-bottom:16px;">
                    The request will be marked as rejected. You can optionally provide a reason.
                </p>
                <form asp-action="Reject" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div style="margin-bottom:16px;">
                        <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">Reason / Notes (optional)</label>
                        <textarea name="adminNotes" rows="4"
                                  style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:13.5px;outline:none;resize:vertical;"
                                  placeholder="e.g. Duplicate request, area not covered..."></textarea>
                    </div>
                    <button type="submit"
                            onclick="return confirm('Are you sure you want to reject this request?')"
                            style="width:100%;background:#dc2626;color:#fff;border:none;border-radius:8px;padding:10px;font-size:13.5px;font-weight:600;cursor:pointer;">
                        <i class="bi bi-x-lg me-1"></i> Reject Request
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        @* Processed info *@
        <div style="grid-column:1/-1;background:#f9fafb;border:1px solid #e5e7eb;border-radius:12px;padding:20px;">
            <div style="font-size:13px;font-weight:600;color:#374151;margin-bottom:8px;">
                <i class="bi bi-calendar-check me-2"></i>Processed on @Model.ProcessedAt?.ToString("MMMM d, yyyy 'at' HH:mm")
            </div>
            @if (!string.IsNullOrEmpty(Model.AdminNotes))
            {
                <div style="font-size:13px;color:#6b7280;">
                    <strong>Notes:</strong> @Model.AdminNotes
                </div>
            }
        </div>
    }

</div>

<div style="margin-top:20px;">
    <a asp-action="Index" style="font-size:13px;color:#9a7a80;text-decoration:none;">
        <i class="bi bi-arrow-left me-1"></i>Back to all requests
    </a>
</div>
