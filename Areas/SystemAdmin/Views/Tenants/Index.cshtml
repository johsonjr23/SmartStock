@model IEnumerable<SmartStock.Models.Tenant>
@{
    ViewData["Title"] = "Tenants";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Tenants</h4>
        <small class="text-muted">All registered businesses on the platform</small>
    </div>
    <a asp-area="SystemAdmin" asp-controller="Tenants" asp-action="Create"
       class="btn btn-danger">
        <i class="bi bi-plus-lg me-1"></i> New Tenant
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No tenants yet. Create the first one above.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Business Name</th>
                        <th>Owner</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="text-muted small">@t.Id</td>
                            <td class="fw-semibold">@t.Name</td>
                            <td>@(t.OwnerName ?? "-")</td>
                            <td>@(t.Email ?? "-")</td>
                            <td>@(t.Phone ?? "-")</td>
                            <td>
                                @if (t.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td class="text-muted small">@t.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (t.IsActive)
                                {
                                    <form asp-area="SystemAdmin" asp-controller="Tenants"
                                          asp-action="Disable" asp-route-id="@t.Id"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Disable @t.Name?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pause-circle"></i> Disable
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-area="SystemAdmin" asp-controller="Tenants"
                                          asp-action="Enable" asp-route-id="@t.Id"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-play-circle"></i> Enable
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
