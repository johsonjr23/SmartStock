@model SmartStock.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="ss-breadcrumb">
    <a asp-action="Index">Products</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">Edit</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Edit Product</h1>
        <p class="page-subtitle">@Model.Name</p>
    </div>
</div>

<form asp-action="Edit" method="post">
<input type="hidden" asp-for="Id" />
<div style="max-width:760px;">

    <div class="ss-form-card">

        <div class="ss-form-section">
            <div class="ss-form-section-title">Basic Information</div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label">Product Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SKU" class="form-label">SKU / Barcode</label>
                    <input asp-for="SKU" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select"
                            asp-items="@(ViewData["Categories"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)">
                        <option value="">— No Category —</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="UnitId" class="form-label">Unit of Measure</label>
                    <select asp-for="UnitId" class="form-select"
                            asp-items="@(ViewData["Units"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)">
                        <option value="">— No Unit —</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="ss-form-section">
            <div class="ss-form-section-title">Pricing &amp; Stock Settings</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="BuyingPrice" class="form-label">Buying Price (TZS)</label>
                    <input asp-for="BuyingPrice" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="SellingPrice" class="form-label">Selling Price (TZS)</label>
                    <input asp-for="SellingPrice" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ReorderLevel" class="form-label">Reorder Level</label>
                    <input asp-for="ReorderLevel" class="form-control" />
                </div>
            </div>
        </div>

        <div class="ss-form-footer">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> Save Changes
            </button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>

    </div>
</div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
