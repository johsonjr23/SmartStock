@model IEnumerable<SmartStock.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Products</h1>
        <p class="page-subtitle">Manage your product catalog and inventory</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Inactive" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-archive"></i> Archived
        </a>
        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-tags"></i> Categories
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Product
        </a>
    </div>
</div>

@* Search bar *@
<form method="get" asp-action="Index" class="filter-bar mb-4">
    <div class="filter-group" style="flex:1;min-width:200px;">
        <label class="filter-label">Search</label>
        <div style="position:relative;">
            <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--ss-text-dim);pointer-events:none;"></i>
            <input type="text" name="search" value="@ViewBag.Search"
                   class="filter-control" style="padding-left:32px;width:100%;"
                   placeholder="Product name or SKU..." />
        </div>
    </div>
    <div style="display:flex;gap:8px;align-items:flex-end;">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-search"></i> Search
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Search?.ToString()))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x"></i> Clear
            </a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="ss-card">
        <div class="ss-empty">
            <i class="bi bi-box-seam ss-empty-icon"></i>
            <div class="ss-empty-title">No products found</div>
            <div class="ss-empty-text">
                @if (!string.IsNullOrWhiteSpace(ViewBag.Search?.ToString()))
                {
                    <span>No results for "<strong>@ViewBag.Search</strong>". Try a different search term.</span>
                }
                else
                {
                    <span>Add your first product to start tracking inventory.</span>
                }
            </div>
            <a asp-action="Create" class="btn btn-primary mt-3">
                <i class="bi bi-plus-circle me-1"></i> Add First Product
            </a>
        </div>
    </div>
}
else
{
    <div class="ss-card">
        <div class="ss-card-body-flush">
            <div class="ss-table-wrap">
                <table class="ss-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>SKU</th>
                            <th class="num">Selling Price</th>
                            <th>Stock</th>
                            <th>Unit</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            var currentStock = ViewBag.Stock != null && ViewBag.Stock.ContainsKey(p.Id)
                                ? ViewBag.Stock[p.Id]
                                : 0;

                            <tr>
                                <td>
                                    <span class="td-name">@p.Name</span>
                                </td>
                                <td>
                                    @if (p.Category != null)
                                    {
                                        <span class="ss-badge ss-badge-neutral">@p.Category.Name</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--ss-text-dim);">—</span>
                                    }
                                </td>
                                <td style="font-family:ui-monospace,monospace;font-size:12.5px;color:var(--ss-text-muted);">
                                    @(string.IsNullOrEmpty(p.SKU) ? "—" : p.SKU)
                                </td>
                                <td class="num" style="font-weight:600;">
                                    @p.SellingPrice.ToString("N0")
                                </td>
                                <td>
                                    @if (currentStock <= 0)
                                    {
                                        <span class="ss-badge ss-badge-danger">
                                            <i class="bi bi-exclamation-circle"></i> Out of Stock
                                        </span>
                                    }
                                    else if (p.ReorderLevel.HasValue && currentStock <= p.ReorderLevel.Value)
                                    {
                                        <span class="ss-badge ss-badge-warning">
                                            <i class="bi bi-exclamation-triangle"></i> Low (@currentStock)
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-weight:600;color:var(--ss-success);font-size:13px;">@currentStock</span>
                                    }
                                </td>
                                <td style="font-size:12.5px;color:var(--ss-text-muted);">
                                    @(p.UnitNavigation?.Name ?? p.Unit ?? "—")
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="Details" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-secondary btn-icon-sm"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="StockIn" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-success btn-icon-sm"
                                           title="Stock In">
                                            <i class="bi bi-plus-square"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-primary btn-icon-sm"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Pagination *@
    @if (ViewBag.TotalPages > 1)
    {
        <div class="ss-pagination">
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-search="@ViewBag.Search">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }
            else
            {
                <span class="disabled"><i class="bi bi-chevron-left"></i></span>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                @if (i == ViewBag.CurrentPage)
                {
                    <span class="active">@i</span>
                }
                else
                {
                    <a asp-action="Index" asp-route-page="@i"
                       asp-route-search="@ViewBag.Search">@i</a>
                }
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-search="@ViewBag.Search">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="disabled"><i class="bi bi-chevron-right"></i></span>
            }
        </div>
    }
}
