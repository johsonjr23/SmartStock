@model IEnumerable<SmartStock.Models.Product>

@{
    ViewData["Title"] = "Archived Products";
}

<div class="ss-breadcrumb">
    <a asp-action="Index">Products</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">Archived</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Archived Products</h1>
        <p class="page-subtitle">Deactivated products — not available for sale</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Active Products
        </a>
    </div>
</div>

<form method="get" asp-action="Inactive" class="filter-bar mb-4">
    <div class="filter-group" style="flex:1;">
        <label class="filter-label">Search Archived</label>
        <div style="position:relative;">
            <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--ss-text-dim);pointer-events:none;"></i>
            <input type="text" name="search" value="@ViewBag.Search"
                   class="filter-control" style="padding-left:32px;width:100%;"
                   placeholder="Product name or SKU..." />
        </div>
    </div>
    <div style="display:flex;gap:8px;align-items:flex-end;">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="ss-card">
        <div class="ss-empty">
            <i class="bi bi-archive ss-empty-icon"></i>
            <div class="ss-empty-title">No archived products</div>
            <div class="ss-empty-text">Deactivated products will appear here.</div>
        </div>
    </div>
}
else
{
    <div class="ss-card">
        <div class="ss-card-body-flush">
            <div class="ss-table-wrap">
                <table class="ss-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th class="num">Selling Price</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <span class="td-name" style="color:var(--ss-text-muted);">@p.Name</span>
                                </td>
                                <td style="color:var(--ss-text-muted);">@(p.Category?.Name ?? "—")</td>
                                <td class="num" style="color:var(--ss-text-muted);">@p.SellingPrice.ToString("N0")</td>
                                <td class="text-center">
                                    <form asp-action="Activate" asp-route-id="@p.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-success">
                                            <i class="bi bi-arrow-repeat me-1"></i> Reactivate
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
