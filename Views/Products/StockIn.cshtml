@model SmartStock.Models.Product

@{
    ViewData["Title"] = "Stock In";
}

<div class="ss-breadcrumb">
    <a asp-action="Index">Products</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">Stock In</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Stock In</h1>
        <p class="page-subtitle">Add received stock for <strong>@Model.Name</strong></p>
    </div>
</div>

<div style="max-width:480px;">
    <div class="ss-form-card">
        <div class="ss-form-section">
            <div class="ss-form-section-title">Product</div>
            <div style="padding:12px 16px;background:var(--ss-primary-light);border-radius:var(--ss-radius);display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;background:var(--ss-primary);border-radius:var(--ss-radius-sm);display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div style="font-weight:700;color:var(--ss-text);">@Model.Name</div>
                    @if (!string.IsNullOrEmpty(Model.SKU))
                    {
                        <div style="font-size:12px;color:var(--ss-text-muted);">SKU: @Model.SKU</div>
                    }
                </div>
            </div>
        </div>

        <form method="post" asp-action="StockIn">
            <input type="hidden" name="productId" value="@Model.Id" />

            <div class="ss-form-section">
                <div class="ss-form-section-title">Quantity to Add</div>
                <div class="mb-1">
                    <label class="form-label">Quantity Received <span class="text-danger">*</span></label>
                    <input type="number" name="quantity" min="1" required
                           class="form-control"
                           style="font-size:20px;text-align:center;font-weight:700;padding:12px;"
                           placeholder="0" autofocus />
                    <div style="font-size:12px;color:var(--ss-text-muted);margin-top:4px;">
                        <i class="bi bi-info-circle"></i> Enter the number of units received.
                    </div>
                </div>
            </div>

            <div class="ss-form-footer">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-plus-square me-1"></i> Add Stock
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
