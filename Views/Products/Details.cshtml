@model SmartStock.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>

<div class="card p-3" style="max-width: 600px;">
    <dl class="row">
        <dt class="col-sm-4">Name</dt>
        <dd class="col-sm-8">@Model.Name</dd>

        <dt class="col-sm-4">Category</dt>
        <dd class="col-sm-8">@(Model.Category?.Name ?? "-")</dd>

        <dt class="col-sm-4">SKU</dt>
        <dd class="col-sm-8">@(Model.SKU ?? "-")</dd>

        <dt class="col-sm-4">Buying Price</dt>
        <dd class="col-sm-8">@Model.BuyingPrice.ToString("0")</dd>

        <dt class="col-sm-4">Selling Price</dt>
        <dd class="col-sm-8">@Model.SellingPrice.ToString("0")</dd>

        <dt class="col-sm-4">Stock</dt>
        <dd class="col-sm-8">@Model.Stock</dd>

        <dt class="col-sm-4">Unit</dt>
        <dd class="col-sm-8">@(Model.UnitNavigation?.Name ?? Model.Unit ?? "-")</dd>

        <dt class="col-sm-4">Reorder Level</dt>
        <dd class="col-sm-8">@(Model.ReorderLevel ?? 0)</dd>

        <dt class="col-sm-4">Created At</dt>
        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</div>

<p class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</p>
