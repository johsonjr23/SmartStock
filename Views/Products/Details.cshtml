@model SmartStock.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="ss-breadcrumb">
    <a asp-action="Index">Products</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">@Model.Name</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">Product details and management</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="StockIn" asp-route-id="@Model.Id" class="btn btn-success">
            <i class="bi bi-plus-square"></i> Stock In
        </a>
        <a asp-action="AdjustStock" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-sliders"></i> Adjust
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
    </div>
</div>

<div style="max-width:700px;">

    <div class="ss-card mb-3">
        <div class="ss-card-header">
            <div class="ss-card-title"><i class="bi bi-info-circle"></i> Product Info</div>
        </div>
        <div class="detail-grid">
            <div class="detail-row">
                <span class="detail-label">Name</span>
                <span class="detail-value">@Model.Name</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Category</span>
                <span class="detail-value">
                    @if (Model.Category != null)
                    {
                        <span class="ss-badge ss-badge-neutral">@Model.Category.Name</span>
                    }
                    else { <span style="color:var(--ss-text-dim);">—</span> }
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">SKU</span>
                <span class="detail-value" style="font-family:ui-monospace,monospace;">
                    @(Model.SKU ?? "—")
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Unit</span>
                <span class="detail-value">@(Model.UnitNavigation?.Name ?? Model.Unit ?? "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Buying Price</span>
                <span class="detail-value">TZS @Model.BuyingPrice.ToString("N0")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Selling Price</span>
                <span class="detail-value" style="color:var(--ss-primary);font-weight:700;">
                    TZS @Model.SellingPrice.ToString("N0")
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Reorder Level</span>
                <span class="detail-value">@(Model.ReorderLevel ?? 0) units</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Created</span>
                <span class="detail-value" style="color:var(--ss-text-muted);">
                    @Model.CreatedAt.ToString("MMM d, yyyy HH:mm")
                </span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Deactivate this product? It will no longer be available for sale.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-archive me-1"></i> Deactivate
            </button>
        </form>
    </div>

</div>
