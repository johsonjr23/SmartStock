@model SmartStock.ViewModels.AdjustStockViewModel


@{
    ViewData["Title"] = "Adjust Stock";
}

<h2>Adjust Stock</h2>

<div class="alert alert-info">
    Use this to correct stock mistakes. Enter a <strong>positive</strong> or <strong>negative</strong> quantity.
</div>

<form asp-action="AdjustStock" method="post">
    <input type="hidden" asp-for="ProductId" />

    <div class="mb-3">
        <label class="form-label">Product</label>
        <input class="form-control" value="@Model.ProductName" disabled />
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason" class="form-control"></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">Apply Adjustment</button>
    <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-secondary">Cancel</a>
</form>
