@model SmartStock.ViewModels.Reports.DailySalesReportViewModel
@{
    ViewData["Title"] = "Daily Sales Summary";
    var tz    = TimeZoneInfo.FindSystemTimeZoneById("E. Africa Standard Time");
    var local = TimeZoneInfo.ConvertTime(Model.GeneratedAtUtc, tz);
}

<style>
    .rpt-header { margin-bottom: 28px; }
    .rpt-title  { font-size: 22px; font-weight: 700; color: #111827; margin: 0 0 2px; }
    .rpt-meta   { font-size: 13px; color: #6b7280; }

    .metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 24px; }
    .metric-card { background: #fff; border-radius: 12px; padding: 18px 20px; border: 1px solid #e5e7eb; }
    .metric-card .mc-label { font-size: 11px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; color: #6b7280; margin-bottom: 6px; }
    .metric-card .mc-value { font-size: 22px; font-weight: 700; color: #111827; line-height: 1; }
    .metric-card .mc-value.green { color: #059669; }
    .metric-card .mc-value.blue  { color: #2563eb; }
    .metric-card .mc-value.amber { color: #d97706; }

    .rpt-card { background: #fff; border-radius: 12px; border: 1px solid #e5e7eb; overflow: hidden; margin-bottom: 20px; }
    .rpt-card-head { padding: 14px 20px; border-bottom: 1px solid #f3f4f6; font-weight: 600; font-size: 14px; color: #374151; display: flex; align-items: center; gap: 8px; }
    .rpt-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .rpt-table th { padding: 11px 16px; background: #f9fafb; font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #6b7280; border-bottom: 1px solid #e5e7eb; }
    .rpt-table td { padding: 11px 16px; border-bottom: 1px solid #f3f4f6; color: #374151; }
    .rpt-table tbody tr:last-child td { border-bottom: none; }
    .rpt-table tfoot td { padding: 12px 16px; font-weight: 700; background: #f9fafb; border-top: 2px solid #e5e7eb; }
    .rpt-table .num { text-align: right; font-variant-numeric: tabular-nums; }

    .rev-bar-wrap { display: flex; align-items: center; gap: 8px; }
    .rev-bar { height: 6px; border-radius: 3px; background: #e5e7eb; flex: 1; overflow: hidden; min-width: 80px; }
    .rev-bar-fill { height: 100%; border-radius: 3px; background: #10b981; }

    @@media print {
        #sidebar, nav.sb-nav, .rpt-no-print { display: none !important; }
        #main-content, body { margin: 0 !important; padding: 0 !important; }
        .rpt-card { border: 1px solid #ccc; }
        @@page { margin: 15mm; }
    }
</style>

<div class="rpt-header d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <div class="rpt-title">
            <i class="bi bi-calendar-check me-2" style="color:#10b981;"></i>Daily Sales Summary
        </div>
        <div class="rpt-meta">
            @Model.TenantName &mdash; @Model.From.ToString("MMM d, yyyy") to @Model.To.ToString("MMM d, yyyy")
            &mdash; Generated @local.ToString("MMM d, yyyy HH:mm")
        </div>
    </div>
    <div class="d-flex gap-2 rpt-no-print">
        <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print / PDF
        </button>
    </div>
</div>

<form method="get" class="rpt-card rpt-no-print mb-4" style="padding:16px 20px;">
    <div class="row g-3 align-items-end">
        <div class="col-sm-auto">
            <label class="form-label mb-1" style="font-size:12px;font-weight:600;">From</label>
            <input type="date" class="form-control form-control-sm" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-sm-auto">
            <label class="form-label mb-1" style="font-size:12px;font-weight:600;">To</label>
            <input type="date" class="form-control form-control-sm" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-sm-auto">
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-funnel me-1"></i>Apply
            </button>
        </div>
        <div class="col-sm-auto">
            <a class="btn btn-sm btn-outline-secondary"
               href="@Url.Action("DailySales")">This Month</a>
        </div>
    </div>
</form>

<div class="metric-grid">
    <div class="metric-card">
        <div class="mc-label">Total Revenue</div>
        <div class="mc-value green">@Model.TotalRevenue.ToString("N2")</div>
    </div>
    <div class="metric-card">
        <div class="mc-label">Transactions</div>
        <div class="mc-value blue">@Model.TotalTransactions</div>
    </div>
    <div class="metric-card">
        <div class="mc-label">Active Days</div>
        <div class="mc-value">@Model.ActiveDays</div>
    </div>
    <div class="metric-card">
        <div class="mc-label">Avg Daily Revenue</div>
        <div class="mc-value amber">@Model.AverageDailyRevenue.ToString("N2")</div>
    </div>
</div>

<div class="rpt-card">
    <div class="rpt-card-head">
        <i class="bi bi-calendar3" style="color:#10b981;"></i>
        Daily Breakdown
    </div>
    @if (Model.Rows.Count == 0)
    {
        <div style="padding:40px;text-align:center;color:#9ca3af;">
            <i class="bi bi-calendar-x" style="font-size:30px;"></i>
            <div class="mt-2">No completed sales in this period.</div>
        </div>
    }
    else
    {
        var maxRev = Model.Rows.Max(r => r.TotalRevenue);
        <div class="table-responsive">
            <table class="rpt-table">
                <thead>
                    <tr>
                        <th style="width:150px;">Date</th>
                        <th>Day</th>
                        <th class="num" style="width:120px;">Transactions</th>
                        <th class="num" style="width:170px;">Revenue</th>
                        <th class="num" style="width:170px;">Avg / Sale</th>
                        <th style="min-width:180px;">Revenue Bar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var barW = maxRev == 0 ? 0 : (double)(row.TotalRevenue / maxRev * 100);
                        <tr>
                            <td style="font-weight:500;">@row.Date.ToString("yyyy-MM-dd")</td>
                            <td style="color:#6b7280;">@row.Date.ToString("ddd")</td>
                            <td class="num">@row.Transactions</td>
                            <td class="num" style="font-weight:600;color:#111827;">@row.TotalRevenue.ToString("N2")</td>
                            <td class="num" style="color:#6b7280;">@row.AveragePerSale.ToString("N2")</td>
                            <td>
                                <div class="rev-bar-wrap">
                                    <div class="rev-bar">
                                        <div class="rev-bar-fill" style="width:@barW.ToString("F0")%;"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2">Total</td>
                        <td class="num">@Model.TotalTransactions</td>
                        <td class="num" style="color:#059669;">@Model.TotalRevenue.ToString("N2")</td>
                        <td class="num" style="color:#6b7280;">@(Model.TotalTransactions == 0 ? "0.00" : (Model.TotalRevenue / Model.TotalTransactions).ToString("N2"))</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>
