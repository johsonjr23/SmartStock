@model SmartStock.ViewModels.Reports.InventoryValuationReportVm




@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = Model.Labels.Title;
    var catOptions = ViewBag.CategoryOptions as SelectList;

    // Show local time in Africa/Dar_es_Salaam
    //var tz = TimeZoneInfo.FindSystemTimeZoneById("Africa/Dar_es_Salaam");
    var tz = TimeZoneInfo.FindSystemTimeZoneById("E. Africa Standard Time");

    var local = TimeZoneInfo.ConvertTime(Model.GeneratedAtUtc, tz);
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-1">@Model.Labels.Title</h2>
        <div class="text-muted">@Model.Labels.Subtitle</div>
    </div>
    <div class="text-muted">
        @Model.Labels.GeneratedAt: @local.ToString("yyyy-MM-dd HH:mm")
    </div>
</div>

<form method="get" class="card card-body mb-3">
    <input type="hidden" name="lang" value="@Model.Lang" />

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">@Model.Labels.Category</label>
            <select class="form-select" name="categoryId">
                <option value="">@Model.Labels.AllCategories</option>
                @if (catOptions != null)
                {
                    foreach (var opt in catOptions)
                    {
                        @if (opt.Selected)
                        {
                            <option value="@opt.Value" selected="selected">@opt.Text</option>
                        }
                        else
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }

                    }
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">@Model.Labels.Search</label>
            <input class="form-control" name="q" value="@Model.Query" placeholder="Name or SKU" />
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check me-3">
                <input class="form-check-input" type="checkbox" id="includeZero" name="includeZero" value="true"
                       @(Model.IncludeZero ? "checked" : "") />
                <label class="form-check-label" for="includeZero">@Model.Labels.IncludeZero</label>
            </div>

            <button type="submit" class="btn btn-primary me-2">@Model.Labels.Apply</button>

            <a class="btn btn-outline-secondary"
               href="@Url.Action("InventoryValuation", "Reports", new { categoryId = (int?)null, includeZero = false, q = (string?)null, lang = Model.Lang })">
                @Model.Labels.Reset
            </a>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th style="width:140px;">@Model.Labels.ColSku</th>
                    <th>@Model.Labels.ColProduct</th>
                    <th style="width:220px;">@Model.Labels.ColCategory</th>
                    <th class="text-end" style="width:140px;">@Model.Labels.ColStockQty</th>
                    <th class="text-end" style="width:160px;">@Model.Labels.ColAvgCost</th>
                    <th class="text-end" style="width:180px;">@Model.Labels.ColStockValue</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Items == null || Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">@Model.Labels.NoItems</td>
                    </tr>
                }
                else
                {
                    foreach (var row in Model.Items)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.SKU) ? "-" : row.SKU)</td>
                            <td>@row.Name</td>
                            <td>@row.Category</td>
                            <td class="text-end">@row.StockQty.ToString("N0")</td>
                            <td class="text-end">@row.AvgCost.ToString("N2")</td>
                            <td class="text-end">@row.InventoryValue.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>

            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">@Model.Labels.TotalUnits</th>
                    <th class="text-end">@Model.TotalStockUnits.ToString("N0")</th>
                    <th></th>
                    <th></th>
                </tr>
                <tr>
                    <th colspan="5" class="text-end">@Model.Labels.TotalValue</th>
                    <th class="text-end">@Model.TotalInventoryValue.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
