@model SmartStock.ViewModels.Reports.InventoryValuationReportVm
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = Model.Labels.Title;
    var catOptions = ViewBag.CategoryOptions as SelectList;
    var tz    = TimeZoneInfo.FindSystemTimeZoneById("E. Africa Standard Time");
    var local = TimeZoneInfo.ConvertTime(Model.GeneratedAtUtc, tz);
}

<style>
    .rpt-header { margin-bottom: 28px; }
    .rpt-title  { font-size: 22px; font-weight: 700; color: #111827; margin: 0 0 2px; }
    .rpt-meta   { font-size: 13px; color: #6b7280; }

    .metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 24px; }
    .metric-card { background: #fff; border-radius: 12px; padding: 18px 20px; border: 1px solid #e5e7eb; }
    .metric-card .mc-label { font-size: 11px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; color: #6b7280; margin-bottom: 6px; }
    .metric-card .mc-value { font-size: 22px; font-weight: 700; color: #111827; line-height: 1; }
    .metric-card .mc-value.green { color: #059669; }
    .metric-card .mc-value.blue  { color: #2563eb; }

    .rpt-card { background: #fff; border-radius: 12px; border: 1px solid #e5e7eb; overflow: hidden; margin-bottom: 20px; }
    .rpt-card-head { padding: 14px 20px; border-bottom: 1px solid #f3f4f6; font-weight: 600; font-size: 14px; color: #374151; display: flex; align-items: center; gap: 8px; }
    .rpt-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .rpt-table th { padding: 11px 16px; background: #f9fafb; font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #6b7280; border-bottom: 1px solid #e5e7eb; }
    .rpt-table td { padding: 11px 16px; border-bottom: 1px solid #f3f4f6; color: #374151; }
    .rpt-table tbody tr:last-child td { border-bottom: none; }
    .rpt-table tfoot td { padding: 12px 16px; font-weight: 700; background: #f9fafb; border-top: 2px solid #e5e7eb; }
    .rpt-table .num { text-align: right; font-variant-numeric: tabular-nums; }
    .sku-badge { font-size: 11px; background: #f3f4f6; color: #6b7280; padding: 2px 7px; border-radius: 4px; font-family: monospace; }
    .lang-switch a { font-size: 12px; color: #6b7280; text-decoration: none; padding: 3px 8px; border-radius: 5px; }
    .lang-switch a.active-lang { background: #f3f4f6; color: #111827; font-weight: 600; }
    .lang-switch span { color: #d1d5db; }

    @@media print {
        #sidebar, nav.sb-nav, .rpt-no-print { display: none !important; }
        #main-content, body { margin: 0 !important; padding: 0 !important; }
        .rpt-card { border: 1px solid #ccc; }
        @@page { margin: 15mm; }
    }
</style>

<div class="rpt-header d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <div class="rpt-title">
            <i class="bi bi-boxes me-2" style="color:#10b981;"></i>@Model.Labels.Title
        </div>
        <div class="rpt-meta">
            @Model.TenantName &mdash; @Model.Labels.GeneratedAt: @local.ToString("MMM d, yyyy HH:mm")
        </div>
    </div>
    <div class="d-flex gap-2 rpt-no-print align-items-center">
        <div class="lang-switch d-flex align-items-center gap-1">
            <a href="@Url.Action("InventoryValuation", new { categoryId = Model.CategoryId, includeZero = Model.IncludeZero, q = Model.Query, lang = "en" })"
               class="@(Model.Lang != "sw" ? "active-lang" : "")">EN</a>
            <span>|</span>
            <a href="@Url.Action("InventoryValuation", new { categoryId = Model.CategoryId, includeZero = Model.IncludeZero, q = Model.Query, lang = "sw" })"
               class="@(Model.Lang == "sw" ? "active-lang" : "")">SW</a>
        </div>
        <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print / PDF
        </button>
    </div>
</div>

<form method="get" class="rpt-card rpt-no-print mb-4" style="padding:16px 20px;">
    <input type="hidden" name="lang" value="@Model.Lang" />
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label mb-1" style="font-size:12px;font-weight:600;">@Model.Labels.Category</label>
            <select class="form-select form-select-sm" name="categoryId">
                <option value="">@Model.Labels.AllCategories</option>
                @if (catOptions != null)
                {
                    foreach (var opt in catOptions)
                    {
                        if (opt.Selected) { <option value="@opt.Value" selected>@opt.Text</option> }
                        else              { <option value="@opt.Value">@opt.Text</option> }
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label mb-1" style="font-size:12px;font-weight:600;">@Model.Labels.Search</label>
            <input class="form-control form-control-sm" name="q" value="@Model.Query" placeholder="Name or SKU" />
        </div>
        <div class="col-md-auto d-flex align-items-end gap-3">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="includeZero" name="includeZero" value="true"
                       @(Model.IncludeZero ? "checked" : "") />
                <label class="form-check-label" for="includeZero" style="font-size:13px;">@Model.Labels.IncludeZero</label>
            </div>
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-funnel me-1"></i>@Model.Labels.Apply
            </button>
            <a class="btn btn-sm btn-outline-secondary"
               href="@Url.Action("InventoryValuation", new { lang = Model.Lang })">
                @Model.Labels.Reset
            </a>
        </div>
    </div>
</form>

<div class="metric-grid">
    <div class="metric-card">
        <div class="mc-label">Products</div>
        <div class="mc-value">@Model.Items.Count</div>
    </div>
    <div class="metric-card">
        <div class="mc-label">@Model.Labels.TotalUnits</div>
        <div class="mc-value blue">@Model.TotalStockUnits.ToString("N0")</div>
    </div>
    <div class="metric-card">
        <div class="mc-label">@Model.Labels.TotalValue</div>
        <div class="mc-value green">@Model.TotalInventoryValue.ToString("N2")</div>
    </div>
</div>

<div class="rpt-card">
    <div class="rpt-card-head">
        <i class="bi bi-box-seam" style="color:#10b981;"></i>
        Stock Inventory
    </div>
    <div class="table-responsive">
        <table class="rpt-table">
            <thead>
                <tr>
                    <th style="width:130px;">@Model.Labels.ColSku</th>
                    <th>@Model.Labels.ColProduct</th>
                    <th>@Model.Labels.ColCategory</th>
                    <th class="num" style="width:130px;">@Model.Labels.ColStockQty</th>
                    <th class="num" style="width:160px;">@Model.Labels.ColAvgCost</th>
                    <th class="num" style="width:170px;">@Model.Labels.ColStockValue</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="6" style="text-align:center;padding:40px;color:#9ca3af;">@Model.Labels.NoItems</td></tr>
                }
                else
                {
                    foreach (var row in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (string.IsNullOrWhiteSpace(row.SKU))
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <span class="sku-badge">@row.SKU</span>
                                }
                            </td>
                            <td style="font-weight:500;">@row.Name</td>
                            <td style="color:#6b7280;">@row.Category</td>
                            <td class="num">@row.StockQty.ToString("N0")</td>
                            <td class="num" style="color:#6b7280;">@row.AvgCost.ToString("N2")</td>
                            <td class="num" style="font-weight:600;color:#111827;">@row.InventoryValue.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3">@Model.Labels.TotalUnits</td>
                    <td class="num">@Model.TotalStockUnits.ToString("N0")</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="5">@Model.Labels.TotalValue</td>
                    <td class="num" style="color:#059669;">@Model.TotalInventoryValue.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
