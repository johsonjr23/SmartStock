@{
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    ViewData["Title"] = "Request Submitted";
}

<div class="auth-page" style="align-items:center;justify-content:center;">
    <div class="auth-panel" style="max-width:480px;text-align:center;">

        <div style="width:72px;height:72px;background:#dcfce7;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:32px;color:#16a34a;">
            <i class="bi bi-check-circle-fill"></i>
        </div>

        <h1 class="auth-heading" style="font-size:22px;">Request Submitted!</h1>
        <p class="auth-subheading" style="margin-bottom:24px;">
            Thank you for your interest in SmartStock. Your request has been received and will be reviewed by our team within <strong>24 hours</strong>.
        </p>

        <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:10px;padding:16px 20px;text-align:left;margin-bottom:28px;">
            <div style="font-size:13px;font-weight:600;color:#0284c7;margin-bottom:8px;">
                <i class="bi bi-info-circle me-1"></i> What happens next?
            </div>
            <ul style="margin:0;padding-left:18px;font-size:13px;color:#374151;line-height:1.8;">
                <li>Our team reviews your application</li>
                <li>You'll receive login credentials via email</li>
                <li>Sign in and start managing your business</li>
            </ul>
        </div>

        <a asp-action="Login" class="auth-btn" style="display:block;text-decoration:none;text-align:center;">
            <i class="bi bi-box-arrow-in-right me-2"></i>Back to Sign In
        </a>
    </div>
</div>
