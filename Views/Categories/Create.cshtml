@model SmartStock.Models.Category

@{
    ViewData["Title"] = "New Category";
}

<div class="ss-breadcrumb">
    <a asp-controller="Products" asp-action="Index">Products</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <a asp-action="Index">Categories</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">New Category</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Add Category</h1>
        <p class="page-subtitle">Group similar products together</p>
    </div>
</div>

@Html.ValidationSummary(false, "", new { @class = "alert alert-danger mb-4" })

<div style="max-width:440px;">
    <div class="ss-form-card">
        <form asp-action="Create" method="post">
            <div class="ss-form-section">
                <div class="mb-0">
                    <label asp-for="Name" class="form-label">Category Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control"
                           placeholder="e.g. Beverages, Electronics, Clothing..."
                           autofocus />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
            <div class="ss-form-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Create Category
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
