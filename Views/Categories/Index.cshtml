@model IEnumerable<SmartStock.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="ss-breadcrumb">
    <a asp-controller="Products" asp-action="Index">Products</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">Categories</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Categories</h1>
        <p class="page-subtitle">Organize products into categories</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Category
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="ss-card">
        <div class="ss-empty">
            <i class="bi bi-tags ss-empty-icon"></i>
            <div class="ss-empty-title">No categories yet</div>
            <div class="ss-empty-text">Create categories to organize your products.</div>
            <a asp-action="Create" class="btn btn-primary mt-3">
                <i class="bi bi-plus-circle me-1"></i> Create First Category
            </a>
        </div>
    </div>
}
else
{
    <div class="ss-card">
        <div class="ss-card-body-flush">
            <div class="ss-table-wrap">
                <table class="ss-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Category Name</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int catIdx = 1; }
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td style="color:var(--ss-text-dim);font-size:12px;width:40px;">@catIdx++</td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:10px;">
                                        <div style="width:32px;height:32px;background:var(--ss-primary-light);border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--ss-primary);font-size:15px;">
                                            <i class="bi bi-tag"></i>
                                        </div>
                                        <span class="td-name">@c.Name</span>
                                    </div>
                                </td>
                                <td style="font-size:12.5px;color:var(--ss-text-muted);">
                                    @c.CreatedAt.ToString("MMM d, yyyy")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
