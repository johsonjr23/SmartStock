@model SmartStock.Models.Expense

@{
    ViewData["Title"] = "Expense Details";
}

<div class="ss-breadcrumb">
    <a asp-action="Index">Expenses</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">@Model.Type — @Model.ExpenseDate.ToString("MMM d, yyyy")</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Expense Details</h1>
        <p class="page-subtitle">Read-only — expenses cannot be edited</p>
    </div>
</div>

<div style="max-width:560px;">
    <div class="ss-card">
        <div class="ss-card-header">
            <div class="ss-card-title">
                <i class="bi bi-wallet2"></i> @Model.Type
            </div>
            <span class="ss-badge ss-badge-danger" style="font-size:16px;padding:6px 16px;">
                TZS @Model.Amount.ToString("N0")
            </span>
        </div>
        <div class="detail-grid">
            <div class="detail-row">
                <span class="detail-label">Expense Date</span>
                <span class="detail-value">@Model.ExpenseDate.ToString("MMMM d, yyyy")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Type</span>
                <span class="detail-value">
                    <span class="ss-badge ss-badge-warning">@Model.Type</span>
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Payee</span>
                <span class="detail-value">@(Model.Payee ?? "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Amount</span>
                <span class="detail-value" style="font-size:18px;font-weight:800;color:var(--ss-danger);">
                    TZS @Model.Amount.ToString("N2")
                </span>
            </div>
            <div class="detail-row" style="grid-column:1/-1;">
                <span class="detail-label">Notes</span>
                <span class="detail-value" style="color:@(Model.Notes == null ? "var(--ss-text-dim)" : "var(--ss-text-2)");">
                    @(Model.Notes ?? "No notes")
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Recorded At</span>
                <span class="detail-value" style="color:var(--ss-text-muted);">
                    @Model.CreatedAt.ToString("MMM d, yyyy HH:mm") UTC
                </span>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Expenses
    </a>
</div>
