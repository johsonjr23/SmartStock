@model SmartStock.ViewModels.CreateExpenseViewModel

@{
    ViewData["Title"] = "New Expense";
}

<div class="ss-breadcrumb">
    <a asp-action="Index">Expenses</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">New Expense</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Record New Expense</h1>
        <p class="page-subtitle">Expenses are permanent and cannot be edited after saving</p>
    </div>
</div>

<div style="max-width:560px;">
    <div class="alert alert-warning d-flex gap-2 align-items-start mb-4">
        <i class="bi bi-lock-fill flex-shrink-0 mt-1"></i>
        <div><strong>Immutable record:</strong> Once saved, this expense cannot be edited or deleted. Please review before submitting.</div>
    </div>

    <div class="ss-form-card">
        <form asp-action="New" method="post">
            @Html.AntiForgeryToken()

            <div class="ss-form-section">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Expense Type <span class="text-danger">*</span></label>
                        <input asp-for="Type" class="form-control"
                               placeholder="e.g. Rent, Transport, Internet, Salaries..." autofocus />
                        <span asp-validation-for="Type" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date <span class="text-danger">*</span></label>
                        <input asp-for="ExpenseDate" type="date" class="form-control" />
                        <span asp-validation-for="ExpenseDate" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Amount (TZS) <span class="text-danger">*</span></label>
                        <input asp-for="Amount" class="form-control"
                               style="font-size:18px;font-weight:700;"
                               placeholder="0.00" />
                        <span asp-validation-for="Amount" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Payee <span style="color:var(--ss-text-dim);font-weight:400;">(optional)</span></label>
                        <input asp-for="Payee" class="form-control" placeholder="Who was paid?" />
                        <span asp-validation-for="Payee" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes <span style="color:var(--ss-text-dim);font-weight:400;">(optional)</span></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="Any additional details..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <div class="ss-form-footer">
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-check-lg me-1"></i> Save Expense
                </button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
