@model SmartStock.ViewModels.CreateSaleViewModel

@{
    ViewData["Title"] = "New Sale";
}

<h2>New Sale</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="SaleDate" class="form-label"></label>
        <input asp-for="SaleDate" type="date" class="form-control" />
        <span asp-validation-for="SaleDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PaymentType" class="form-label"></label>
        <select asp-for="PaymentType" class="form-control">
            <option value="Cash">Cash</option>
            <option value="Credit">Credit</option>
        </select>
        <span asp-validation-for="PaymentType" class="text-danger"></span>
    </div>

    <hr />

    <h4>Items</h4>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th style="width:120px;">Quantity</th>
                <th style="width:150px;">Unit Price</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        <select asp-for="Items[@i].ProductId"
                                asp-items="ViewBag.Products"
                                class="form-control">
                            <option value="">-- Select Product --</option>
                        </select>
                        <span asp-validation-for="Items[@i].ProductId" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Items[@i].Quantity"
                               class="form-control" />
                        <span asp-validation-for="Items[@i].Quantity" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Items[@i].SellingPrice"
                               type="hidden"
                               class="form-control" />
                        <span asp-validation-for="Items[@i].SellingPrice" class="text-danger"></span>
                    </td>

                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">
        Save Sale
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
