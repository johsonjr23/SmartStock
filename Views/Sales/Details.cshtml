@model SmartStock.ViewModels.SaleDetailsViewModel
@{
    ViewData["Title"] = "Sale Receipt";
}
<style>
    .receipt-wrap { max-width: 700px; margin: 0 auto; }
    .muted { opacity: 0.72; }
    .mono { font-family: ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Courier New",monospace; }

    @@media print {
        #sidebar, #main-wrap > header, .ss-topbar, .no-print { display: none !important; }
        #main-wrap { margin-left: 0 !important; }
        body { background: #fff !important; }
        .receipt-wrap { max-width: 80mm !important; margin: 0 !important; }
        .card, .shadow, .shadow-sm { box-shadow: none !important; border: none !important; }
        a[href]:after { content: "" !important; }
    }
    @@page { size: 80mm auto; margin: 6mm; }
</style>

<div class="ss-breadcrumb no-print">
    <a asp-action="Index">Sales</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">Receipt</span>
</div>

<div class="receipt-wrap">

    <!-- Top buttons (no-print) -->
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <div class="d-flex gap-2">
            <a asp-action="Index" asp-controller="Sales" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Sales
            </a>
            <a asp-action="New" asp-controller="Sales" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> New Sale
            </a>
        </div>
        <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Receipt
        </button>
    </div>

    <!-- Actions (no-print): only show for Completed sales -->
    @if (Model.Status == "Completed")
    {
        <div class="card mb-3 no-print">
            <div class="card-body">

                <!-- VOID -->
                <form asp-action="Void" asp-controller="Sales" method="post" class="d-flex gap-2 align-items-center mb-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input name="reason" class="form-control form-control-sm" placeholder="Void reason (required)" />
                    <button type="submit" class="btn btn-danger btn-sm"
                            onclick="return confirm('Void this sale? This reverses inventory and stamps the receipt as VOID.');">
                        Void Sale
                    </button>
                </form>

                <!-- FULL REFUND -->
                <form asp-action="RefundFull" asp-controller="Sales" method="post" class="d-flex gap-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input name="reason" class="form-control form-control-sm" placeholder="Refund reason (required)" />
                    <button type="submit" class="btn btn-warning btn-sm"
                            onclick="return confirm('Refund this sale in full? This returns stock and creates a REFUND receipt.');">
                        Full Refund
                    </button>
                </form>

            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <!-- TOP OF RECEIPT: VOID stamp -->
            @if (Model.Status == "Voided")
            {
                <div class="alert alert-danger py-2 mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="h5 mb-1">VOID</div>
                            @if (!string.IsNullOrWhiteSpace(Model.VoidReason))
                            {
                                <div class="mono">Reason: @Model.VoidReason</div>
                            }
                        </div>
                        @if (Model.VoidedAt.HasValue)
                        {
                            <div class="text-end muted mono">@Model.VoidedAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
                        }
                    </div>
                </div>
            }

            <!-- TOP OF RECEIPT: REFUND stamp (this is a refund receipt) -->
            @* Requires refund fields in SaleDetailsViewModel *@
            @if (Model.Status == "Refunded" && Model.OriginalSaleId != null)
            {
                <div class="alert alert-warning py-2 mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="h5 mb-1">REFUND</div>
                            <div class="mono">Original: SALE-@Model.OriginalSaleId.Value.ToString("D6")</div>
                            @if (!string.IsNullOrWhiteSpace(Model.RefundReason))
                            {
                                <div class="mono">Reason: @Model.RefundReason</div>
                            }
                        </div>
                        @if (Model.RefundedAt.HasValue)
                        {
                            <div class="text-end muted mono">@Model.RefundedAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
                        }
                    </div>
                </div>
            }

            <!-- If viewing original sale that was refunded, show a banner -->
            @if (Model.Status == "Refunded" && Model.OriginalSaleId == null)
            {
                <div class="alert alert-warning py-2 mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="h6 mb-1">REFUNDED</div>
                            @if (!string.IsNullOrWhiteSpace(Model.RefundReason))
                            {
                                <div class="mono">Reason: @Model.RefundReason</div>
                            }
                        </div>
                        @if (Model.RefundedAt.HasValue)
                        {
                            <div class="text-end muted mono">@Model.RefundedAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
                        }
                    </div>
                </div>
            }

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h4 class="mb-1">SmartStock</h4>
                    <div class="muted">Receipt</div>
                </div>

                <div class="text-end">
                    <div class="mono"><strong>@Model.DisplayInvoiceNumber</strong></div>
                    <div class="muted">@Model.SaleDate.ToString("yyyy-MM-dd HH:mm")</div>
                    <div class="muted">Payment: @Model.PaymentType</div>
                </div>
            </div>

            <hr />

            <!-- Items -->
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div><strong>@item.ProductName</strong></div>
                                    @if (!string.IsNullOrWhiteSpace(item.SKU))
                                    {
                                        <div class="muted mono">SKU: @item.SKU</div>
                                    }
                                </td>
                                <td class="text-end">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end">@item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <hr />

            <!-- Totals -->
            <div class="d-flex justify-content-end">
                <div style="min-width: 280px;">
                    <div class="d-flex justify-content-between">
                        <div class="muted">Items</div>
                        <div>@Model.Items.Count</div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <div class="h5 mb-0">Total</div>
                        <div class="h5 mb-0">@Model.TotalAmount.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <div class="text-center muted mt-3" style="font-size: 0.9rem;">
                Thank you for your purchase.
            </div>
        </div>
    </div>

    <div class="mt-3 muted no-print">
        Tip: Use “Print” for a clean receipt output.
    </div>
</div>
