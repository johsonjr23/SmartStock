@model IEnumerable<SmartStock.Models.Sale>

@{
    ViewData["Title"] = "Sales";
}

<h2>Sales</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">New Sale</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Invoice</th>
            <th>Payment Type</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center">No sales recorded.</td>
            </tr>
        }
        else
        {
            foreach (var sale in Model)
            {
                <tr>
                    <td>@sale.SaleDate.ToString("yyyy-MM-dd")</td>
                    <td>@(sale.InvoiceNumber ?? "-")</td>
                    <td>@sale.PaymentType</td>
                    <td>@sale.TotalAmount.ToString("N0")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@sale.Id" class="btn btn-sm btn-info">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
