@model List<SmartStock.Models.Sale>
@using SmartStock.Models

@{
    ViewData["Title"] = "Sales";
}

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Sales</h1>
        <p class="page-subtitle">Latest @(Model?.Count ?? 0) transaction(s)</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="New" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Sale
        </a>
    </div>
</div>

@if (Model == null || Model.Count == 0)
{
    <div class="ss-card">
        <div class="ss-empty">
            <i class="bi bi-receipt ss-empty-icon"></i>
            <div class="ss-empty-title">No sales yet</div>
            <div class="ss-empty-text">Complete your first sale to see it listed here.</div>
            <a asp-action="New" class="btn btn-primary mt-3">
                <i class="bi bi-plus-circle me-1"></i> Start First Sale
            </a>
        </div>
    </div>
}
else
{
    <div class="ss-card">
        <div class="ss-card-body-flush">
            <div class="ss-table-wrap">
                <table class="ss-table">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Status</th>
                            <th>Date &amp; Time</th>
                            <th class="num">Total (TZS)</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <span style="font-family:ui-monospace,monospace;font-size:13px;font-weight:600;color:var(--ss-text);">
                                        @(!string.IsNullOrWhiteSpace(s.InvoiceNumber)
                                            ? s.InvoiceNumber
                                            : $"SALE-{s.Id:D6}")
                                    </span>
                                </td>
                                <td>
                                    @if (s.Status == SaleStatus.Voided)
                                    {
                                        <span class="ss-badge ss-badge-danger"><i class="bi bi-x-circle"></i> Voided</span>
                                    }
                                    else if (s.Status == SaleStatus.Refunded && s.OriginalSaleId != null)
                                    {
                                        <span class="ss-badge ss-badge-info"><i class="bi bi-arrow-left-right"></i> Refund</span>
                                    }
                                    else if (s.Status == SaleStatus.Refunded)
                                    {
                                        <span class="ss-badge ss-badge-warning"><i class="bi bi-arrow-counterclockwise"></i> Refunded</span>
                                    }
                                    else
                                    {
                                        <span class="ss-badge ss-badge-success"><i class="bi bi-check-circle"></i> Completed</span>
                                    }
                                </td>
                                <td>
                                    <span style="font-size:13px;color:var(--ss-text-2);">@s.CreatedAt.ToString("MMM d, yyyy")</span>
                                    <span style="font-size:12px;color:var(--ss-text-muted);margin-left:4px;">@s.CreatedAt.ToString("HH:mm")</span>
                                </td>
                                <td class="num" style="font-weight:700;font-size:14px;color:var(--ss-text);">
                                    @s.TotalAmount.ToString("N0")
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@s.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <p style="font-size:12px;color:var(--ss-text-dim);text-align:center;margin-top:-16px;">
        Showing latest @Model.Count sale(s)
    </p>
}
