@model SmartStock.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "Add Team Member";
}

<div class="ss-breadcrumb">
    <a asp-controller="Users" asp-action="Index">Team</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">Add Member</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Add Team Member</h1>
        <p class="page-subtitle">New user will be scoped to your business only</p>
    </div>
</div>

<div style="max-width:560px;">

    <form asp-controller="Users" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="alert alert-danger mb-4"></div>

        <div class="ss-form-card">

            <div class="ss-form-section">
                <div class="ss-form-section-title">Personal Details</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. John Mwangi" autofocus />
                        <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="user@example.com" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <div class="ss-form-section">
                <div class="ss-form-section-title">Role &amp; Access</div>
                <div class="mb-0">
                    <label asp-for="Role" class="form-label">Role <span class="text-danger">*</span></label>
                    <select asp-for="Role" class="form-select">
                        <option value="Manager">Manager — full product &amp; expense access</option>
                        <option value="Cashier">Cashier — sales only</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="ss-form-section">
                <div class="ss-form-section-title">Password</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Min. 6 characters" />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Repeat password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <div class="ss-form-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-plus me-1"></i> Create Account
                </button>
                <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
